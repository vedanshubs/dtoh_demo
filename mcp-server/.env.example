# ── Mock flags ────────────────────────────────────────────────────────────────
# Set to false to call real eScreen SOAP API for clinic search
USE_MOCK_CLINICS=false
# Set to false to call real eScreen SOAP API for booking (RegisterScheduledEvent)
USE_MOCK_BOOKINGS=false
# Set to false to query real MySQL DB for analytics
USE_MOCK_ANALYTICS=false

# ── eScreen SOAP credentials ───────────────────────────────────────────────────
ESCREEN_USERNAME=UBS
ESCREEN_PASSWORD=
# IMPORTANT: must be UB-Staffing — NOT UB-016118 (that code returns 0 results)
ESCREEN_ELECTRONIC_CLIENT_ID=UB-Staffing
ESCREEN_CUSTOM_PANEL=725146
# IMPORTANT: must match CollectionOrder.AccountNumber in the MySQL DB (UBS001 for demo DB)
ESCREEN_CLIENT_ACCOUNT=UBS001
ESCREEN_CLIENT_SUB_ACCOUNT=209
# Required by RegisterScheduledEvent — must not be empty or booking will fail
ESCREEN_CUSTOM_FIELD_1=020919
ESCREEN_CUSTOM_FIELD_2=Order 1

# ── PFX client certificate (mutual TLS — required for all SOAP calls) ─────────
# Place UBS 2.pfx in the repo root (it is gitignored) OR set an absolute path
ESCREEN_PFX_PATH=../UBS 2.pfx
ESCREEN_PFX_PASSPHRASE=

# ── Database (MySQL via Docker) ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3307
DB_USER=escreen
DB_PASSWORD=escreen
DB_NAME=escreen

# ── MCP server port ────────────────────────────────────────────────────────────
MCP_PORT=8010
