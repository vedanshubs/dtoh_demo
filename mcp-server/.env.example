# Clinic booking: set to false to use real eScreen GetCollectionSites SOAP API
USE_MOCK_CLINICS=true
# Booking: set to false to use real eScreen RegisterScheduledEvent SOAP API
USE_MOCK_BOOKINGS=true
# Analytics: set to false to query real MySQL DB
USE_MOCK_ANALYTICS=false

# eScreen SOAP credentials (from eScreen partner setup)
ESCREEN_USERNAME=UBS
ESCREEN_PASSWORD=
ESCREEN_ELECTRONIC_CLIENT_ID=UB-Staffing
ESCREEN_CUSTOM_PANEL=725146
ESCREEN_CLIENT_ACCOUNT=142451
ESCREEN_CLIENT_SUB_ACCOUNT=209
ESCREEN_CUSTOM_FIELD_1=
ESCREEN_CUSTOM_FIELD_2=
# Path to PFX client certificate (relative to repo root or absolute)
ESCREEN_PFX_PATH=../UBS 2.pfx
# Passphrase for the PFX file
ESCREEN_PFX_PASSPHRASE=

# Database (MySQL via Docker)
DB_HOST=localhost
DB_PORT=3307
DB_USER=escreen
DB_PASSWORD=escreen
DB_NAME=escreen

# HTTP transport port (for Claude Desktop / ChatGPT Actions)
MCP_PORT=8010
